# Rust build output
/target
**/*.rs.bk

# Note: Cargo.lock IS committed. This is a binary, not a library, and
# reproducible dependency versions matter when real funds are involved.

# Environment and secrets — never commit these
.env
.env.local
.env.bak
wallet.json
*.pem

# Runtime state (trade ledger, which also backs the cumulative loss cap)
data/
logs/
*.log

# IDE
.idea/
.vscode/

# OS
.DS_Store
