# ---------------------------------------------------------------------------
# Wallet (REQUIRED) — never commit the actual key file
# ---------------------------------------------------------------------------
# Absolute path ("~" is NOT expanded). Accepts either format:
#   - Solana CLI JSON byte array, from `solana-keygen new --outfile <path>`
#   - raw base58 secret key, as exported from Phantom or Solflare
WALLET_PATH=/home/you/.config/solana/bot-wallet.json

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# devnet | mainnet. Usually left unset: each execution mode picks its own
# cluster (rehearse => devnet, simulate/live => mainnet).
# SOLANA_NETWORK=mainnet

# Optional RPC override. When unset, the cluster default is used.
# Public endpoints are heavily rate limited — use a paid provider
# (Helius/QuickNode/Triton) for anything beyond casual testing.
# SOLANA_RPC_URL=https://your-provider.example/?api-key=...

# ---------------------------------------------------------------------------
# Jupiter aggregator
# ---------------------------------------------------------------------------
# Leave JUPITER_API_KEY unset to use the free tier (lite-api.jup.ag).
# Setting a key automatically switches to the paid host (api.jup.ag).
# JUPITER_API_KEY=
# JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1

# ---------------------------------------------------------------------------
# Strategy
# ---------------------------------------------------------------------------
# Minimum NET profit (after fees and priority fee) required to act.
MIN_PROFIT_PERCENTAGE=1.5
SLIPPAGE_BPS=50
PRIORITY_FEE_MICROLAMPORTS=1000
POLL_INTERVAL_SECS=10

# ---------------------------------------------------------------------------
# Discord alerts (optional)
# ---------------------------------------------------------------------------
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook,
# then Copy Webhook URL. No bot token or gateway connection needed.
# Treat this URL as a secret: anyone holding it can post to your channel.
# Leave unset to disable alerts entirely.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# ---------------------------------------------------------------------------
# Safety caps — BOTH are required before `--mode live` will submit anything
# ---------------------------------------------------------------------------
# Maximum committed per individual trade.
MAX_TRADE_AMOUNT_SOL=0.01

# Maximum cumulative realised loss before the bot halts. Tracked across
# restarts in data/trades.json; profits do NOT top this budget back up.
# Clear that file to reset, once you understand why it tripped.
MAX_CUMULATIVE_LOSS_SOL=0.05
